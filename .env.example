# Eusatis Environment Variables

# Supabase Configuration
# Required for live Supabase PostgreSQL database, Supabase Auth, and Row Level Security.
# When not provided, the application runs seamlessly in local preview mode with persistent browser storage.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# App Deployment Host URL (Used for canonical URLs, OpenGraph sharing cards, and SEO)
APP_URL="https://eusatis.org"
